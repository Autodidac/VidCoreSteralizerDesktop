    "metadata query artwork properties",
)
metadata = replace_once(
    metadata,
    "      GROUP BY ?item ?itemLabel ?itemDescription ?date ?image ?imdb\n               ?movieTmdb ?tvTmdb ?article",
    "      GROUP BY ?item ?itemLabel ?itemDescription ?date ?poster ?logo ?image ?imdb\n               ?movieTmdb ?tvTmdb ?article",
    "metadata query group by artwork",
)
metadata = replace_once(
    metadata,
    '      image: bindingValue(binding, "image").replace(/^http:/, "https:"),',
    '''      image: selectArtworkImage(entry, {
        title: bindingValue(binding, "itemLabel") || fallbackTitle(entry),
        year: bindingValue(binding, "date").slice(0, 4)
      }, [
        { kind: "poster", value: bindingValue(binding, "poster") },
